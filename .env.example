# Cache and abuse limits.
STATS_CACHE_TTL_SECONDS=600
MIN_REFRESH_SECONDS=60
SUBMISSIONS_PER_WINDOW=8
RATE_LIMIT_WINDOW_SECONDS=600
CALLOUT_PAGE_LIMIT=50
CALLOUT_MAX_PAGES=20
