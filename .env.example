# Pump.fun public API. Do not point this at an arbitrary host.
# Allowed: https://frontend-api-v3.pump.fun
PUMPFUN_API_BASE_URL=https://frontend-api-v3.pump.fun

# Optional. Sent as Authorization: Bearer only from the server.
# Leave empty. The verified public stats routes respond without a token.
# Do not put a user session token here to read private analytics.
PUMPFUN_API_TOKEN=

# live uses Pump.fun. demo returns labeled fixtures and never claims to be live.
PUMPFUN_DATA_MODE=live

# Postgres connection (Supabase, Neon, or Vercel Postgres).
# Also read from POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING, or SUPABASE_DATABASE_URL.
# When none are set, profile pages still load public Pump.fun statistics.
# Saved checks are stored in data/airdropme-store.json and are not shared across serverless instances.
DATABASE_URL=

# Admin session. Leave blank to disable the admin panel.
# Use a long random secret. Never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Salt for hashing submission IPs in audit data. Not a password.
IP_HASH_SALT=replace-with-a-long-random-string

# Token distribution stays off until a verified, funded distributor exists.
# Setting this to true without a distributor records a failed claim, it does not transfer tokens.
DISTRIBUTION_ENABLED=false

# Public Solana RPC used by the wallet adapter to connect. The claim flow only requests a signature.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public site origin used in referral links. Defaults to https://www.calloutdrop.app.
SITE_URL=https://www.calloutdrop.app

# Firebase API connection for referral links, referral history, and the top 100 leaderboard.
# The server reads these names from the environment. Use the API key or a service account.
# Leave FIREBASE_API_BASE unset in production. This app never deletes referral history.
